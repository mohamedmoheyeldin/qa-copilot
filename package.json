{
    "name": "qa-copilot",
    "version": "1.0.0",
    "description": "AI helpers for QA: bug reports and test cases with Playwright, Cypress, Selenium, WebdriverIO, and Cucumber BDD code. Runs entirely in the browser.",
    "keywords": [
        "qa",
        "testing",
        "test-automation",
        "playwright",
        "cypress",
        "selenium",
        "webdriverio",
        "cucumber",
        "bdd",
        "gherkin",
        "bug-report",
        "test-cases",
        "ai",
        "llm",
        "claude",
        "openai",
        "gemini",
        "jira",
        "sdet"
    ],
    "homepage": "https://mohamedmoheyeldin.github.io/qa-copilot/",
    "repository": {
        "type": "git",
        "url": "https://github.com/mohamedmoheyeldin/qa-copilot.git"
    },
    "bugs": {
        "url": "https://github.com/mohamedmoheyeldin/qa-copilot/issues"
    },
    "author": "Mohamed Moheyeldin (https://mohamedmoheyeldin.com)",
    "license": "MIT",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:edge": "playwright test",
        "media": "node scripts/capture-media.mjs && node scripts/encode-media.mjs",
        "test:unit": "vitest run",
        "test": "vitest run && playwright test"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@untitledui/file-icons": "^0.0.9",
        "@untitledui/icons": "^0.0.23",
        "docx": "^9.9.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "jszip": "^3.10.2",
        "motion": "^13.4.4",
        "qr-code-styling": "^1.9.2",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-hotkeys-hook": "^5.3.3",
        "react-router": "^8.4.0",
        "react-stately": "^3.50.0",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "write-excel-file": "^4.1.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=22"
    }
}
